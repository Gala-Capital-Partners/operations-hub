# Backend Tasks API base URL (copy this file to .env.local to override)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Real sign-in with Supabase Auth. Leave both empty to keep the demo role picker.
# Local values come from `npx supabase status` (API URL and Publishable key).
# The publishable key is safe in the browser; never put a secret key or DATABASE_URL here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
